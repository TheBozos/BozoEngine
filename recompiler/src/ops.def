OP(CACHE,     "cache",    0)
OP(LWC1,      "lwc1",     0)
OP(PREF,      "pref",     0)
OP(LQC2,      "lqc2",     0)
OP(LD,        "ld",       0)
OP(SWC1,      "swc1",     0)
