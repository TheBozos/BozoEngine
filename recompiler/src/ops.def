// The R5900 (PlayStation 2 Emotion Engine) instruction set as BozoEngine's recompiler knows it.
//
// One line per instruction: OP(identifier, mnemonic, flags). The decoder (decoder.cpp) maps an instruction word to
// one of these; the emitter (emitter.cpp) translates each one. The flags tell the control-flow analysis what an
// instruction does to the program counter. Semantics: docs/specs/r5900.md.
//
// Flags (decoder.h): BR = conditional branch with a delay slot, LK = "likely" (the delay slot runs only when the
// branch is taken), JMP = unconditional jump with a delay slot, LNK = writes a return address, IND = target from a
// register, TRAP = may stop with an exception, ENDS = execution does not fall through to the next instruction.

// ---- Not an instruction we know -------------------------------------------------------------------------------------
OP(Unknown,   "unknown",  0)

// ---- Primary opcodes ------------------------------------------------------------------------------------------------
OP(J,         "j",        JMP | ENDS)
OP(JAL,       "jal",      JMP | LNK)
OP(BEQ,       "beq",      BR)
OP(BNE,       "bne",      BR)
OP(BLEZ,      "blez",     BR)
OP(BGTZ,      "bgtz",     BR)
OP(ADDI,      "addi",     TRAP)
OP(ADDIU,     "addiu",    0)
OP(SLTI,      "slti",     0)
OP(SLTIU,     "sltiu",    0)
OP(ANDI,      "andi",     0)
OP(ORI,       "ori",      0)
OP(XORI,      "xori",     0)
OP(LUI,       "lui",      0)
OP(BEQL,      "beql",     BR | LK)
OP(BNEL,      "bnel",     BR | LK)
OP(BLEZL,     "blezl",    BR | LK)
OP(BGTZL,     "bgtzl",    BR | LK)
OP(DADDI,     "daddi",    TRAP)
OP(DADDIU,    "daddiu",   0)
OP(LDL,       "ldl",      0)
OP(LDR,       "ldr",      0)
OP(LQ,        "lq",       0)
OP(SQ,        "sq",       0)
